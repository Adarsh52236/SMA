# Backend Environment Configuration Template
PROJECT_NAME="Crop Yield Prediction API"
ENVIRONMENT=development
API_V1_STR=/api/v1

# Allowed CORS Origins (comma-separated or JSON list)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://sma-frontend.vercel.app

# Model artifact configuration
MODEL_DIR=models
MODEL_FILENAME=crop_yield_model.joblib
METADATA_FILENAME=model_metadata.json

# Domain scope
TARGET_CROP=Soybean
TARGET_STATE=Maharashtra
TARGET_SEASON=Kharif
